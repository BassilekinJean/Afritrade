# --------------------------------------------------------------------------- #
#  Supabase — Auth + Data API + Storage
# --------------------------------------------------------------------------- #
# Le backend NE se connecte PAS à Postgres directement : il valide les jetons
# via l'API Auth et lit/écrit les projets via l'API Data (PostgREST) avec la
# clé service_role. Aucun mot de passe de base de données n'est requis.

# URL du projet Supabase (identique à VITE_SUPABASE_URL côté front).
SUPABASE_URL=https://votre-projet.supabase.co

# Clé "anon" (publique) — sert à valider les jetons utilisateur.
SUPABASE_ANON_KEY=sb_publishable_xxx

# Clé "service_role" (SECRÈTE) — accès Data API + Storage côté serveur.
# Ne JAMAIS l'exposer côté front ni la committer.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Nom du bucket de stockage des fichiers sources (CSV / JSON / SQLite).
SUPABASE_BUCKET=projets

# Origines autorisées (CORS), séparées par des virgules.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Assistant IA (optionnel, reste côté backend). Compatible OpenAI.
# Sans clé, un générateur heuristique local prend le relais.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Fournisseur compatible OpenAI (défaut https://api.openai.com/v1).
# Ex. gratuit : Groq -> https://api.groq.com/openai/v1 (modèle llama-3.3-70b-versatile)
# OPENAI_BASE_URL=https://api.openai.com/v1
