# Connexion PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afritrade

# Sécurité JWT
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clé OpenAI (optionnelle, pour l'assistant IA)
# OPENAI_API_KEY=sk-...
