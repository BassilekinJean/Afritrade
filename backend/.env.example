# --------------------------------------------------------------------------- #
#  Authentification locale (SQLite + JWT)
# --------------------------------------------------------------------------- #
# Secret de signature des jetons JWT. À CHANGER en production (valeur longue et aléatoire).
JWT_SECRET=change-me-with-a-long-random-secret
# Durée de validité d'une session (heures).
JWT_EXPIRE_HOURS=12

# Compte administrateur initial, créé automatiquement au premier démarrage
# (uniquement si la base ne contient encore aucun compte). Connexion par username.
ADMIN_USERNAME=aaprovidir
ADMIN_PASSWORD=aaprovidir

# --------------------------------------------------------------------------- #
#  Divers
# --------------------------------------------------------------------------- #
# Origines autorisées (CORS), séparées par des virgules.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dossier de données local (bases SQLite + fichiers importés).
# DATAPIPE_DATA_DIR=/chemin/vers/.data

# URL publique de l'API (pour afficher les URLs webhook).
# PUBLIC_API_URL=http://localhost:8000

# --------------------------------------------------------------------------- #
#  Assistant IA (optionnel — sans clé, un générateur heuristique local prend le relais)
# --------------------------------------------------------------------------- #
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
